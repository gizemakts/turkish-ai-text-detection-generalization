  "ai_prompting_method": {
    "full_human_text_supplied": false,
    "input_fields": [
      "input_id",
      "output_id",
      "title",
      "keywords",
      "target_words"
    ],
    "requested_output_fields": [
      "id",
      "generated_text"
    ],
    "original_turkish_column_requested": true,
    "internet_search_prohibited": true,
    "real_published_column_retrieval_or_reproduction_prohibited": true,
    "target_tolerance_words": 15,
    "outside_tolerance_action": "SEPARATE_LENGTH_CORRECTION",
    "length_correction_must_preserve": [
      "topic",
      "main idea",
      "viewpoint",
      "narrative line"
    ],
    "length_correction_content_change_prohibited": true,
    "procedure_classification": "LENGTH_MATCHING_NOT_NEW_GENERATION_CONDITION"
  },
  "rows_are_paired": true,
  "pairing_status": "CONFIRMED_1_TO_1",
  "n_pairs": 500,
  "pairing_key": "numeric_record_suffix",
  "pairing_examples": [
    "human_001<->AI_record_001",
    "human_500<->AI_record_500"
  ],
  "primary_bootstrap_unit": "pair_id",
  "invalid_pair_integrity_action": "ABORT_EVALUATION",
  "human_file_schema": {
    "row_id_column": "RESOLVE_FROM_LOCKED_HEADER",
    "text_column": "RESOLVE_FROM_LOCKED_HEADER",
    "pair_id_column": null,
    "pair_id_derivation": "NUMERIC_SUFFIX_FROM_RESOLVED_ROW_ID"
  },
  "ai_file_schema": {
    "row_id_column": "RESOLVE_FROM_LOCKED_HEADER",
    "text_column": "RESOLVE_FROM_LOCKED_HEADER",
    "pair_id_column": null,
    "pair_id_derivation": "NUMERIC_SUFFIX_FROM_RESOLVED_ROW_ID"
  },
  "schema_resolution_policy": {
    "mode": "LOCKED_HASH_THEN_HEADER_ONLY_UNIQUE_ALIAS",
    "raw_hash_verification_before_csv_parser": true,
    "header_read_after_hash_match_only": true,
    "row_read_after_unique_resolution_only": true,
    "header_matching": "EXACT_CASE_SENSITIVE",
    "ambiguity_rule": "EXACTLY_ONE_CANDIDATE_PRESENT_PER_ROLE_ELSE_ABORT",
    "manual_selection_after_header": false,
    "required_columns": {
      "human": {
        "row_id_column_candidates": [
          "id",
          "input_id",
          "human_id",
          "record_id",
          "source_id"
        ],
        "text_column_candidates": [
          "text",
          "human_text",
          "article_text",
          "column_text",
          "content",
          "metin",
          "yazi",
          "kose_yazisi"
        ]
      },
      "ai": {
        "row_id_column_candidates": [
          "id",
          "output_id",
          "ai_id",
          "record_id"
        ],
        "text_column_candidates": [
          "generated_text"
        ]
      }
    },
    "pair_id_derivation": "NUMERIC_SUFFIX_FROM_RESOLVED_ROW_ID",
    "pair_suffix_regex": "([0-9]+)$",
    "required_pair_indices": {
      "first": 1,
      "last": 500,
      "exactly_once_per_class": true
    }
  },
  "expected_locked_files": {
    "human": "human_newspaper_columns_500.csv",
